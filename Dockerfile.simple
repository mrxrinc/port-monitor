# Simple Dockerfile for Linux build only
# For Windows builds, use native Windows environment (see BUILD.md)

FROM ubuntu:22.04

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies
RUN apt-get update && apt-get install -y \
    python3.10 \
    python3-pip \
    python3-dev \
    libxcb-xinerama0 \
    libxcb-icccm4 \
    libxcb-image0 \
    libxcb-keysyms1 \
    libxcb-randr0 \
    libxcb-render-util0 \
    libxcb-shape0 \
    libxkbcommon-x11-0 \
    libdbus-1-3 \
    libgl1-mesa-glx \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install Rust toolchain to vendor a defmt-print binary for this platform
ENV CARGO_HOME=/root/.cargo
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"
RUN cargo install defmt-print

WORKDIR /app

# Upgrade pip
RUN pip3 install --no-cache-dir --upgrade pip setuptools wheel

# Copy and install requirements
COPY requirements.txt .
RUN pip3 install --no-cache-dir \
    PyQt5-Qt5>=5.15.2 \
    PyQt5-sip>=12.11.0 \
    PyQt5>=5.15.0 \
    pyserial>=3.5 \
    pyinstaller

# Copy application
COPY . .

# Vendor the linux defmt-print binary built above
RUN mkdir -p vendor/defmt-print/linux-x86_64 && \
    cp /root/.cargo/bin/defmt-print vendor/defmt-print/linux-x86_64/defmt-print

# Build executable
RUN pyinstaller \
    --windowed \
    --icon=icon.png \
    --name 'PortMonitor' \
    --add-binary "vendor/defmt-print/linux-x86_64/defmt-print:vendor/defmt-print/linux-x86_64" \
    --clean \
    main.py

# Default command
CMD ["/bin/bash"]
